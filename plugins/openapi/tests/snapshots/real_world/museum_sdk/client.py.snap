        cls, *, base_url: str, config: ClientConfig | None = None
    ) -> SyncAPI:
        import httpx
        from eazy_sdk.handlers.httpx import HttpxHandler

        raw = httpx.Client(base_url=base_url, headers={}, cookies={})
        handler = HttpxHandler(raw, owns_client=True)
